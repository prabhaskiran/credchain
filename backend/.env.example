# Copy this file to .env and fill in real values.

# Local Hardhat node (started with: npx hardhat node)
RPC_URL=http://127.0.0.1:8545

# Paste the address printed by `npm run deploy:local` in the contracts project
CONTRACT_ADDRESS=

# Any private key printed by `npx hardhat node` (it funds a test account with
# 10,000 fake ETH — safe to use only on your local network, never on mainnet)
ISSUER_PRIVATE_KEY=

PORT=4000
